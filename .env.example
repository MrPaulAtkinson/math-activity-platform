# Copy to .env for local development. Never commit .env.

# Claude API key (from platform.claude.com). Required for AI features.
ANTHROPIC_API_KEY=

# Password for the teacher pages. If empty, a random one is printed at startup.
TEACHER_PASSCODE=

# Desmos API key. The default is Desmos's public demo key, which is for
# development only - get your own key from Desmos before using it with a class.
DESMOS_API_KEY=dcb31709b452b1cf9dc26972add0fda6
DESMOS_API_VERSION=v1.11

PORT=3000
